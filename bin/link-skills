#!/usr/bin/env bash
# Symlink every skill in this repo into ~/.claude/skills so Claude Code loads it
# in place. Each skill needs its own link, so a new skill is invisible until
# this runs. Safe to re-run: existing correct links are left alone, and a name
# that is already taken by something else is reported, never overwritten.
#
# Usage:
#   bin/link-skills          create any missing links
#   bin/link-skills --check  list missing links only; exit 1 if any are missing

set -uo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
DEST="${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}"
CHECK=0
[ "${1:-}" = "--check" ] && CHECK=1

missing=0
for skill_md in "$REPO"/*/skills/*/SKILL.md; do
	[ -e "$skill_md" ] || continue
	src="$(dirname "$skill_md")"
	name="$(basename "$src")"
	link="$DEST/$name"

	if [ -L "$link" ] && [ "$(readlink "$link")" = "$src" ]; then
		continue
	fi
	if [ -e "$link" ] || [ -L "$link" ]; then
		echo "skip $name: $link already exists and points elsewhere" >&2
		continue
	fi

	missing=$((missing + 1))
	if [ "$CHECK" -eq 1 ]; then
		echo "unlinked: $name"
	else
		mkdir -p "$DEST"
		ln -s "$src" "$link" && echo "linked: $name"
	fi
done

if [ "$CHECK" -eq 1 ] && [ "$missing" -gt 0 ]; then
	exit 1
fi
exit 0
